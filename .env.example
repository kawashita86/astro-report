# Every variable this application reads. The first seven are required — none
# has a default, and startup fails naming any that is missing or invalid. The
# last ones, USE_REAL_GEMINI_LOCALLY, GEMINI_MODEL and GENERATION_CONCURRENCY,
# are optional.
# Read in exactly one place: shell/config.py.
#
# Copy to .env for local use (.env is git-ignored and never committed).
# Astronomical tuning values do NOT belong here; they live in data/computation.toml.

# Which environment this process is. Permitted values: local, production.
# There is deliberately no staging.
ENVIRONMENT=local

# Postgres connection URL. Accepted schemes: postgres, postgresql, postgresql+psycopg.
# Local (docker compose): postgresql://astro:astro@postgres:5432/astro_report
# Production: the Postgres on the Coolify VPS (Netcup, Vienna), set in Coolify.
DATABASE_URL=postgresql://astro:astro@localhost:5432/astro_report

# The port to serve on. Production sets it in the Coolify application's environment.
PORT=8000

# Argon2 hash of the single sign-in password (Story 1.4). Generate one with:
#   uv run python -c "import argon2; print(argon2.PasswordHasher().hash('your-password'))"
# Never the plaintext password itself, and never a real one committed here.
# The value below hashes "local-dev-password" — fine for docker compose, never for production.
AUTH_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$BoNaYBFxFkVYK0EWHFpjhQ$siqk2ea0LCm0U9ClzlqGrirWdOUG70cH8vNB1cGODMU

# HMAC key that signs the session cookie (Story 1.4). At least 32 random
# characters. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=local-dev-only-session-secret-key-change-me-0000

# Gemini API key for the configured Generator adapter (Story 4.5, AD-9).
# Exactly one Generator adapter is configured, ever -- no runtime failover.
# Under ENVIRONMENT=local this value is never sent to Gemini by default:
# get_generator() returns RecordedResponseGenerator instead, which replays
# payload-derived sentences without calling the provider (Story 4.9) --
# unless USE_REAL_GEMINI_LOCALLY below is explicitly set to true.
GEMINI_API_KEY=your-gemini-api-key

# ISO date (YYYY-MM-DD) the Gemini data terms were verified (NFR-17): the
# account is on the paid tier (Paid Services data terms), and startup refuses
# to run without this recorded.
# The dated check itself lives in docs/release-validation/gemini-data-terms.md.
# When that record's `checked` date changes, update this value to match.
# As with GEMINI_API_KEY above, this is only sent anywhere under
# ENVIRONMENT=local if USE_REAL_GEMINI_LOCALLY below is set to true.
GEMINI_DATA_TERMS_VERIFIED_AT=2026-10-01

# Optional (Story 10.2). The Gemini model the Generator calls. Defaults to
# gemini-2.5-flash when unset or blank.
# GEMINI_MODEL=gemini-2.5-flash

# Optional (Story 10.2). How many Section generations may run at once: an
# integer from 1 to 32. Defaults to 11 when unset or blank.
# GENERATION_CONCURRENCY=11

# Optional (Story 4.9's opt-out). Permitted values: true, false. Defaults to
# false when unset or blank. Under ENVIRONMENT=local, generator_for_settings() normally
# returns RecordedResponseGenerator and never calls Gemini regardless of
# GEMINI_API_KEY above -- set this to true (deliberately, never as a
# deployment default) to exercise the real GeminiGenerator against a local
# Postgres instead, using the real key set above.
USE_REAL_GEMINI_LOCALLY=false
